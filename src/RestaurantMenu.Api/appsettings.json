{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "RestaurantMenu.Api",
    "OtlpEndpoint": null
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Api": {
    "RequestTimeout": "00:00:15"
  },
  "Authentication": {
    "MetadataAddress": "https://identity.example.com/realms/restaurant-menu/.well-known/openid-configuration",
    "ValidIssuer": "https://identity.example.com/realms/restaurant-menu",
    "Audience": "restaurant-menu-api",
    "RequireHttpsMetadata": true
  },
  "KeycloakAdmin": {
    "BaseUrl": null,
    "Realm": null,
    "ClientId": null,
    "ClientSecret": null
  },
  "Caching": {
    "Redis": {
      "ConnectTimeoutMilliseconds": 1000,
      "OperationTimeoutMilliseconds": 1000
    },
    "Restaurants": {
      "TimeToLive": "00:05:00"
    }
  },
  "DiningSessions": {
    "Lifetime": "02:00:00"
  },
  "ConnectionStrings": {
    "RabbitMq": "amqp://guest:guest@localhost:5672/"
  },
  "Messaging": {
    "ExchangeName": "restaurant-menu.events",
    "BatchSize": 50,
    "PollingInterval": "00:00:01",
    "InitialRetryDelay": "00:00:01",
    "MaximumAttempts": 10,
    "ClaimDuration": "00:01:00"
  },
  "Notifications": {
    "QueueName": "restaurant-menu.notifications",
    "RecoveryDelay": "00:00:02"
  },
  "Stripe": {
    "ApiBaseUrl": "https://api.stripe.com/",
    "SecretKey": null,
    "WebhookSecret": null
  },
  "AllowedHosts": "*"
}
