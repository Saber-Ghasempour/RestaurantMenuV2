{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "RestaurantMenu.Api",
    "OtlpEndpoint": null
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Caching": {
    "Redis": {
      "ConnectTimeoutMilliseconds": 1000,
      "OperationTimeoutMilliseconds": 1000
    },
    "Restaurants": {
      "TimeToLive": "00:05:00"
    }
  },
  "AllowedHosts": "*"
}
